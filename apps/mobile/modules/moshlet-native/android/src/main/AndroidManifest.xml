<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- For the Wi-Fi low-latency lock while a terminal is on screen, and to stay awake for approval alerts. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- SSH to the computer. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Approval alerts: notifications, and a service that keeps the connection open in the background. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <activity
            android:name="dev.moshlet.nativebits.OpenPaneActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <service
            android:name="dev.moshlet.nativebits.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the SSH connection to the user's own computer open, to notify them when a coding agent there needs their approval." />
        </service>
    </application>
</manifest>
