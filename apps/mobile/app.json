{
  "expo": {
    "name": "Corral",
    "slug": "corral",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "corral",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "dev.corral.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6D3FE0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.corral.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0A12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      "expo-secure-store",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Corral uses the microphone to dictate prompts.",
          "speechRecognitionPermission": "Corral turns your speech into prompts for your agents.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Corral uses Face ID to unlock your computers."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
